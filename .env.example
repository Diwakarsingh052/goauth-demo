# =============================================================================
# Database Configuration
# =============================================================================
# For Docker: DB_HOST=mysql, DB_PASSWORD=rootpassword (matches docker-compose.yml)
# For local:  DB_HOST=localhost, DB_PASSWORD=(your local MySQL password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=challange_go

# =============================================================================
# Server Ports
# =============================================================================
API_PORT=8080
WEB_PORT=8081
API_BASE_URL=http://localhost:8080

# =============================================================================
# Security Secrets (CHANGE THESE IN PRODUCTION)
# =============================================================================
JWT_SECRET=your-jwt-secret-key-change-me
SESSION_SECRET=your-session-secret-key-change-me

# =============================================================================
# Google OAuth 2.0 Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8081/auth/google/callback