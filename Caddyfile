# =============================================================================
# Caddyfile — Reverse proxy for challange-go-cyaz
# Replace {$DOMAIN} with your actual domain or set it as an env var.
# Caddy automatically provisions and renews TLS certificates via Let's Encrypt.
# =============================================================================

{$DOMAIN:localhost} {
	# --- Web frontend (primary) ---
	# All traffic goes to the Go web server by default.
	reverse_proxy web:8081

	# --- Static file caching ---
	@static path /static/*
	header @static Cache-Control "public, max-age=2592000"

	# --- Security headers ---
	header {
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "strict-origin-when-cross-origin"
		-Server
	}

	# --- Logging ---
	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}

# =============================================================================
# Optional: Expose the REST API on a subdomain.
# Remove or comment out this block if the API should stay internal only.
# =============================================================================
api.{$DOMAIN:localhost} {
	reverse_proxy api:8080

	header {
		X-Content-Type-Options  "nosniff"
		-Server
	}

	log {
		output file /var/log/caddy/api-access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}