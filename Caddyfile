# =============================================================================
# Caddyfile — Reverse proxy for challange-go-cyaz
# Serves over plain HTTP on port 80 (no TLS — IP-based deployment).
#
# When you get a domain later, replace :80 with your domain name
# (e.g. yourdomain.com) and Caddy will auto-provision HTTPS.
# =============================================================================

:80 {
	# --- Web frontend ---
	# All traffic goes to the Go web server.
	reverse_proxy web:8081

	# --- Static file caching ---
	@static path /static/*
	header @static Cache-Control "public, max-age=2592000"

	# --- Security headers ---
	header {
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "strict-origin-when-cross-origin"
		-Server
	}

	# --- Logging ---
	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
